<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Click To Add Flowers</title>
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  #canvas { display: block; width: 100vw; height: 100vh; cursor: pointer; }
  #hint {
    position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
    pointer-events: none; color: #f4f4f4; user-select: none;
    font-family: "Times New Roman", Georgia, serif; font-size: clamp(20px, 4vw, 42px);
    letter-spacing: .5px; text-shadow: 0 0 18px rgba(255,255,255,.25);
  }
</style>
</head>
<body>
<canvas id="canvas"></canvas>
<div id="hint">Click To Add Flowers</div>

<script type="module">
import * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';

/* ---------- то, что было видно на видео (строки 1–15) ---------- */
const flowerElements = document.querySelector("#canvas");
let renderer = new THREE.WebGLRenderer({
  canvas: flowerElements,
  alpha: true,
  antialias: true,
});

let sceneShader = new THREE.Scene();   // резкие процедурные цветы -> в RT
let sceneBasic  = new THREE.Scene();   // композит (размытие) + стебли -> на экран
let camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 10);
let clock = new THREE.Clock();
let renderTargets = [
  new THREE.WebGLRenderTarget(1, 1),
  new THREE.WebGLRenderTarget(1, 1),
];

/* ---------- вспомогательная сцена для blur-проходов ---------- */
const blurScene = new THREE.Scene();
const blurCam   = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 10);
const quadGeo   = new THREE.PlaneGeometry(2, 2);

const blurMat = new THREE.ShaderMaterial({
  uniforms: {
    map:       { value: null },
    texel:     { value: new THREE.Vector2(1, 1) },
    direction: { value: new THREE.Vector2(1, 0) },
  },
  vertexShader: `
    varying vec2 vUv;
    void main(){ vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }`,
  fragmentShader: `
    precision highp float;
    uniform sampler2D map; uniform vec2 texel; uniform vec2 direction;
    varying vec2 vUv;
    void main(){
      vec2 o = texel * direction;
      vec4 c = texture2D(map, vUv) * 0.2270270270;
      c += (texture2D(map, vUv + o*1.3846153846) + texture2D(map, vUv - o*1.3846153846)) * 0.3162162162;
      c += (texture2D(map, vUv + o*3.2307692308) + texture2D(map, vUv - o*3.2307692308)) * 0.0702702703;
      gl_FragColor = c;
    }`,
  depthTest: false, depthWrite: false, transparent: true,
});
const blurQuad = new THREE.Mesh(quadGeo, blurMat);
blurScene.add(blurQuad);

/* композитный квад: рисует размытые цветы из RT поверх всего */
const compositeMat = new THREE.MeshBasicMaterial({
  map: renderTargets[0].texture, transparent: true, depthTest: false, depthWrite: false,
});
const compositeQuad = new THREE.Mesh(quadGeo, compositeMat);
compositeQuad.renderOrder = 0;
sceneBasic.add(compositeQuad);

/* ---------- шейдер одного цветка ---------- */
const flowerVert = `
  varying vec2 vUv;
  void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }`;

const flowerFrag = `
  precision highp float;
  varying vec2 vUv;
  uniform float uTime, uPhase, uPetals, uPetalLength, uSoft, uOpacity, uGrow, uRotation;
  uniform vec3 uColorCenter, uColorMid, uColorEdge;

  void main(){
    vec2 p = (vUv - 0.5) * 2.0;
    float rot = uRotation + sin(uTime*0.6 + uPhase)*0.12;   // лёгкое покачивание бутона
    float cs = cos(rot), sn = sin(rot);
    p = mat2(cs, -sn, sn, cs) * p;

    float ang = atan(p.y, p.x);
    float rad = length(p);
    float petal = 0.5 + 0.5*cos(ang * uPetals);             // uPetals лепестков
    float R = max(uPetalLength * (0.35 + 0.65*pow(petal, 0.6)), 0.001);

    float edge = smoothstep(R, R - uSoft, rad);             // мягкий контур
    float t = clamp(rad / R, 0.0, 1.0);

    vec3 col = mix(uColorCenter, uColorMid, smoothstep(0.0, 0.45, t));
    col = mix(col, uColorEdge, smoothstep(0.40, 1.0, t));
    float core = smoothstep(0.30, 0.0, rad);                // яркая сердцевина
    col = mix(col, uColorCenter, core * 0.7);

    float alpha = edge * uOpacity * uGrow;
    if (alpha < 0.001) discard;
    gl_FragColor = vec4(col, alpha);
  }`;

/* ---------- палитры как на видео (центр / середина / край) ---------- */
function hsl(h, s, l){ return new THREE.Color().setHSL(h, s, l); }
const PALETTES = [
  [hsl(0.13,0.95,0.62), hsl(0.92,0.85,0.62), hsl(0.80,0.80,0.55)], // жёлт->розов->фиолет
  [hsl(0.16,0.95,0.60), hsl(0.02,0.90,0.60), hsl(0.95,0.85,0.58)], // жёлт->оранж->малина
  [hsl(0.25,0.85,0.55), hsl(0.78,0.80,0.60), hsl(0.72,0.85,0.50)], // зелень->сирень->фиолет
  [hsl(0.12,0.95,0.65), hsl(0.90,0.80,0.65), hsl(0.78,0.75,0.60)],
  [hsl(0.15,0.90,0.60), hsl(0.05,0.90,0.62), hsl(0.83,0.80,0.58)],
];

const SEGMENTS = 26;
const flowers = [];   // { mesh, stem, base, ctrl, top, phase, swayAmp, swaySpd, grow, born }

function rand(a, b){ return a + Math.random() * (b - a); }

function addFlower(worldX, worldY){
  const pal   = PALETTES[(Math.random()*PALETTES.length)|0];
  const phase = rand(0, Math.PI*2);
  const size  = rand(0.10, 0.20);

  /* соцветие — квадратный plane в мировых единицах (камера aspect-correct => круглый) */
  const mat = new THREE.ShaderMaterial({
    uniforms: {
      uTime:{value:0}, uPhase:{value:phase}, uPetals:{value:(rand(4,6)|0)},
      uPetalLength:{value:rand(0.78,0.95)}, uSoft:{value:rand(0.45,0.7)},
      uOpacity:{value:rand(0.85,1.0)}, uGrow:{value:0}, uRotation:{value:rand(0,6.28)},
      uColorCenter:{value:pal[0]}, uColorMid:{value:pal[1]}, uColorEdge:{value:pal[2]},
    },
    vertexShader: flowerVert, fragmentShader: flowerFrag,
    transparent: true, depthTest: false, depthWrite: false,
  });
  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1,1), mat);
  mesh.scale.set(size, size, 1);
  mesh.position.set(worldX, worldY, 0);
  sceneShader.add(mesh);

  /* стебель: квадратичная кривая Безье от низа экрана до бутона */
  const base = new THREE.Vector2(worldX + rand(-0.04,0.04), -1.05);
  const top  = new THREE.Vector2(worldX, worldY - size*0.45);
  const ctrl = new THREE.Vector2((base.x+top.x)/2 + rand(-0.5,0.5), (base.y+top.y)/2);

  const full = [];   // покоящаяся форма (без покачивания)
  for (let i=0;i<=SEGMENTS;i++){
    const t=i/SEGMENTS, it=1-t;
    full.push(new THREE.Vector2(
      it*it*base.x + 2*it*t*ctrl.x + t*t*top.x,
      it*it*base.y + 2*it*t*ctrl.y + t*t*top.y ));
  }

  const posAttr = new Float32Array((SEGMENTS+1)*3);
  const colAttr = new Float32Array((SEGMENTS+1)*3);
  const cLow  = new THREE.Color(0x2f7d32);
  const cHigh = new THREE.Color(0xcddc39);
  for (let i=0;i<=SEGMENTS;i++){
    const t=i/SEGMENTS, c=cLow.clone().lerp(cHigh, t);
    colAttr[i*3]=c.r; colAttr[i*3+1]=c.g; colAttr[i*3+2]=c.b;
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(posAttr,3));
  g.setAttribute('color',    new THREE.BufferAttribute(colAttr,3));
  const stem = new THREE.Line(g, new THREE.LineBasicMaterial({
    vertexColors:true, transparent:true, opacity:0.9, depthTest:false, depthWrite:false }));
  stem.renderOrder = 1;
  sceneBasic.add(stem);

  flowers.push({ mesh, stem, base, full, phase,
    swayAmp: rand(0.02,0.06), swaySpd: rand(0.6,1.3),
    grow:0, born: clock.getElapsedTime(), size });
}

/* ---------- клик / тач ---------- */
function pointerToWorld(cx, cy){
  const r = renderer.domElement.getBoundingClientRect();
  const nx =  ((cx - r.left)/r.width )*2 - 1;
  const ny = -(((cy - r.top )/r.height)*2 - 1);
  const a = r.width / r.height;
  return [nx*a, ny];
}
window.addEventListener('pointerdown', e => {
  const [wx,wy] = pointerToWorld(e.clientX, e.clientY);
  addFlower(wx, wy);
});

/* ---------- resize ---------- */
function onResize(){
  const w = window.innerWidth, h = window.innerHeight, pr = Math.min(devicePixelRatio,2);
  renderer.setPixelRatio(pr);
  renderer.setSize(w, h);
  const a = w/h;
  camera.left=-a; camera.right=a; camera.top=1; camera.bottom=-1; camera.updateProjectionMatrix();
  const rw = Math.floor(w*pr), rh = Math.floor(h*pr);
  renderTargets[0].setSize(rw, rh);
  renderTargets[1].setSize(rw, rh);
  blurMat.uniforms.texel.value.set(1/rw, 1/rh);
}
window.addEventListener('resize', onResize);
onResize();

/* ---------- цикл ---------- */
function animate(){
  requestAnimationFrame(animate);
  const time = clock.getElapsedTime();

  for (const f of flowers){
    // распускание (ease-out)
    const age = time - f.born;
    f.grow = Math.min(1, age/0.8);
    const g = 1 - Math.pow(1 - f.grow, 3);
    f.mesh.material.uniforms.uGrow.value = g;
    f.mesh.material.uniforms.uTime.value = time;
    f.mesh.scale.set(f.size*g, f.size*g, 1);

    // покачивание стебля + рост от основания
    const arr = f.stem.geometry.attributes.position.array;
    for (let i=0;i<=SEGMENTS;i++){
      const t=i/SEGMENTS;
      const sway = f.swayAmp * Math.pow(t,1.5) * Math.sin(time*f.swaySpd + f.phase);
      const fx = f.full[i].x + sway;
      const fy = f.full[i].y;
      arr[i*3]   = f.base.x + (fx - f.base.x)*g;
      arr[i*3+1] = f.base.y + (fy - f.base.y)*g;
      arr[i*3+2] = 0;
    }
    f.stem.geometry.attributes.position.needsUpdate = true;
    f.mesh.position.set(arr[SEGMENTS*3], arr[SEGMENTS*3+1], 0); // бутон на кончике стебля
  }

  /* 1) резкие цветы -> RT0 */
  renderer.setRenderTarget(renderTargets[0]);
  renderer.clear();
  renderer.render(sceneShader, camera);

  /* 2) blur ping-pong: RT0 ->(H)-> RT1 ->(V)-> RT0 */
  blurMat.uniforms.map.value = renderTargets[0].texture;
  blurMat.uniforms.direction.value.set(1,0);
  renderer.setRenderTarget(renderTargets[1]); renderer.clear(); renderer.render(blurScene, blurCam);

  blurMat.uniforms.map.value = renderTargets[1].texture;
  blurMat.uniforms.direction.value.set(0,1);
  renderer.setRenderTarget(renderTargets[0]); renderer.clear(); renderer.render(blurScene, blurCam);

  /* 3) композит на экран: размытые цветы + стебли */
  compositeMat.map = renderTargets[0].texture;
  renderer.setRenderTarget(null);
  renderer.clear();
  renderer.render(sceneBasic, camera);
}
animate();
</script>
</body>
</html>
